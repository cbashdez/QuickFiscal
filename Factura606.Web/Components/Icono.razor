@* Íconos SVG monolínea, en vez de emoji — se ven igual en cualquier PC sin depender
   de qué fuente de emoji tenga instalada el sistema. Heredan el color del texto
   (stroke="currentColor"), así funcionan igual en botones primarios y secundarios. *@

@switch (Nombre)
{
    case "subir":
        <svg viewBox="0 0 24 24" class="icono-qf" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 16V4" /><path d="M6 9l6-6 6 6" /><path d="M4 20h16" />
        </svg>
        break;
    case "descargar":
        <svg viewBox="0 0 24 24" class="icono-qf" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4v12" /><path d="M6 11l6 6 6-6" /><path d="M4 20h16" />
        </svg>
        break;
    case "respaldo":
        <svg viewBox="0 0 24 24" class="icono-qf" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="7" ry="3" />
            <path d="M5 5v6c0 1.66 3.13 3 7 3s7-1.34 7-3V5" />
            <path d="M5 11v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6" />
        </svg>
        break;
    case "salir":
        <svg viewBox="0 0 24 24" class="icono-qf" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="M16 17l5-5-5-5" /><path d="M21 12H9" />
        </svg>
        break;
    case "foto":
        <svg viewBox="0 0 24 24" class="icono-qf" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="3" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" />
        </svg>
        break;
}

@code {
    [Parameter, EditorRequired]
    public string Nombre { get; set; } = "";
}
